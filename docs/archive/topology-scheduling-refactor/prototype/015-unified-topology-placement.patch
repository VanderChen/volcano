+
+package api
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestTopologyNodeScopeExactComposition(t *testing.T) {
+	jobScope := NewTopologyNodeScope("node-a", "node-b", "node-c")
+	subJobScope := NewTopologyNodeScope("node-b", "node-c", "node-d")
+
+	got := jobScope.Intersect(subJobScope)
+	if want := []string{"node-b", "node-c"}; !reflect.DeepEqual(got.SortedNodeNames(), want) {
+		t.Fatalf("intersection = %v, want %v", got.SortedNodeNames(), want)
+	}
+	if want := []string{"node-a", "node-b", "node-c", "node-d"}; !reflect.DeepEqual(jobScope.Union(subJobScope).SortedNodeNames(), want) {
+		t.Fatalf("union = %v, want %v", jobScope.Union(subJobScope).SortedNodeNames(), want)
+	}
+
+	got.Nodes.Insert("node-e")
+	if jobScope.Has("node-e") || subJobScope.Has("node-e") {
+		t.Fatalf("composed scope aliases an input scope")
+	}
+}
