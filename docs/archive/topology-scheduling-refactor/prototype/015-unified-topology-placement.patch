+	cloned.RealNodesList = make(map[string][]*api.NodeInfo, len(source.RealNodesList))
+	for hyperNode, nodes := range source.RealNodesList {
+		for _, node := range nodes {
+			cloned.RealNodesList[hyperNode] = append(cloned.RealNodesList[hyperNode], node.Clone())
+		}
+	}
+	return cloned
