+	task := tasks[0]
+	if task.Status != api.Pending || task.NodeName != "" || task.Pod.Spec.NodeName != "" {
+		t.Fatalf("failed Pipeline leaked task state: status=%v node=%q podNode=%q",
+			task.Status, task.NodeName, task.Pod.Spec.NodeName)
+	}
+	if len(node.Tasks) != 0 {
+		t.Fatalf("failed Pipeline leaked node task: %v", node.Tasks)
+	}
+	if eventBalance != 0 {
+		t.Fatalf("failed Pipeline event balance = %d, want 0", eventBalance)
+	}
