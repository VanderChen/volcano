+func BenchmarkUnifiedTopologyBacktrack(b *testing.B) {
+	var extenderAllocateCalls atomic.Int64
+	var extenderDeallocateCalls atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		switch request.URL.Path {
+		case "/allocate":
+			extenderAllocateCalls.Add(1)
+		case "/deallocate":
+			extenderDeallocateCalls.Add(1)
+		}
+		writer.Header().Set("Content-Type", "application/json")
+		if err := json.NewEncoder(writer).Encode(&extender.EventHandlerResponse{}); err != nil {
+			b.Errorf("write fake extender response: %v", err)
+		}
+	}))
+	defer server.Close()
+
+	for _, testCase := range []struct {
+		name               string
+		successAlternative int
+		budget             int
+		wantKind           topologyPlacementResultKind
+	}{
+		{name: "success-alternative-1", successAlternative: 1, budget: 64, wantKind: topologyPlacementFound},
+		{name: "success-alternative-2", successAlternative: 2, budget: 64, wantKind: topologyPlacementFound},
+		{name: "success-alternative-4", successAlternative: 4, budget: 64, wantKind: topologyPlacementFound},
+		{name: "success-alternative-8", successAlternative: 8, budget: 64, wantKind: topologyPlacementFound},
+		{name: "budget-exhausted", successAlternative: 0, budget: 8, wantKind: topologyPlacementBudgetExceeded},
+	} {
+		b.Run(testCase.name, func(b *testing.B) {
+			var totalAttempts int
+			var totalExtraAttempts int
+			var totalBacktracks int
+			var totalAllocateCalls int64
+			var totalDeallocateCalls int64
+
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				var pluginAllocateCalls atomic.Int64
+				var pluginDeallocateCalls atomic.Int64
+				extenderAllocateCalls.Store(0)
+				extenderDeallocateCalls.Store(0)
+
+				test, ssn, action := newBacktrackBenchmarkFixture(
+					b,
+					testCase.successAlternative,
+					testCase.budget,
+					server.URL,
+					&pluginAllocateCalls,
+					&pluginDeallocateCalls,
+				)
+				test.Run([]framework.Action{action})
+
+				job := ssn.Jobs[api.JobID("default/target")]
+				result := action.lastTopologyPlacementResult[job.UID]
+				if result.kind != testCase.wantKind {
+					test.Close()
+					b.Fatalf("result=%s, want %s; attempts=%d extra=%d backtracks=%d err=%v",
+						result.kind, testCase.wantKind, result.attempts, result.extra, result.backtracks, result.err)
+				}
+				if result.attempts > 2+testCase.budget {
+					test.Close()
+					b.Fatalf("attempts=%d exceed working-set+budget=%d", result.attempts, 2+testCase.budget)
+				}
+
+				allocateCalls := pluginAllocateCalls.Load()
+				deallocateCalls := pluginDeallocateCalls.Load()
+				if got := extenderAllocateCalls.Load(); got != allocateCalls {
+					test.Close()
+					b.Fatalf("extender allocate calls=%d, plugin allocate calls=%d", got, allocateCalls)
+				}
+				if got := extenderDeallocateCalls.Load(); got != deallocateCalls {
+					test.Close()
+					b.Fatalf("extender deallocate calls=%d, plugin deallocate calls=%d", got, deallocateCalls)
+				}
+				if allocateCalls != int64(result.attempts) {
+					test.Close()
+					b.Fatalf("allocate calls=%d, attempts=%d", allocateCalls, result.attempts)
+				}
+
+				if testCase.wantKind == topologyPlacementFound {
+					wantNode := fmt.Sprintf("node-%02d", testCase.successAlternative)
+					if got := job.Tasks[api.TaskID("default-task-a")].NodeName; got != wantNode {
+						test.Close()
+						b.Fatalf("task-a node=%q, want %q", got, wantNode)
+					}
+					if got := job.Tasks[api.TaskID("default-task-b")].NodeName; got != "node-16" {
+						test.Close()
+						b.Fatalf("task-b node=%q, want node-16", got)
+					}
+				} else {
+					for _, task := range job.Tasks {
+						if task.Status != api.Pending || task.NodeName != "" {
+							test.Close()
+							b.Fatalf("budget result leaked task state: task=%s status=%v node=%q",
+								task.UID, task.Status, task.NodeName)
+						}
+					}
+					for _, node := range ssn.Nodes {
+						if len(node.Tasks) != 0 {
+							test.Close()
+							b.Fatalf("budget result leaked %d tasks on node %s", len(node.Tasks), node.Name)
+						}
+					}
+				}
+
+				totalAttempts += result.attempts
+				totalExtraAttempts += result.extra
+				totalBacktracks += result.backtracks
+				totalAllocateCalls += allocateCalls
+				totalDeallocateCalls += deallocateCalls
+				test.Close()
+			}
+
+			b.ReportMetric(float64(totalAttempts)/float64(b.N), "attempts/op")
+			b.ReportMetric(float64(totalExtraAttempts)/float64(b.N), "extra-attempts/op")
+			b.ReportMetric(float64(totalBacktracks)/float64(b.N), "backtracks/op")
+			b.ReportMetric(float64(totalAllocateCalls)/float64(b.N), "allocate-callbacks/op")
+			b.ReportMetric(float64(totalDeallocateCalls)/float64(b.N), "deallocate-callbacks/op")
+		})
+	}
+}
