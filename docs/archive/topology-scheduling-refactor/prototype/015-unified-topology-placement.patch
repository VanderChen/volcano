+func TestStatementAllocateNodeFailurePreservesExistingTask(t *testing.T) {
+	ssn, tasks, node := newStatementTestSession(t, 1)
+	existing := tasks[0].Clone()
+	if err := node.AddTask(existing); err != nil {
+		t.Fatalf("seed existing node task: %v", err)
+	}
+	idleBefore := node.Idle.Clone()
+	deallocateCalls := 0
+	ssn.eventHandlers = []*EventHandler{{
+		DeallocateFunc: func(_ *Event) {
+			deallocateCalls++
+		},
+	}}
+
+	stmt := NewStatement(ssn)
+	err := stmt.Allocate(tasks[0], node)
+	if err == nil {
+		t.Fatalf("Allocate returned nil for duplicate node task")
+	}
+	if got := len(node.Tasks); got != 1 {
+		t.Fatalf("node task count after failed Allocate = %d, want seeded task only", got)
+	}
+	if !node.Idle.Equal(idleBefore, api.Zero) {
+		t.Fatalf("node idle changed after failed Allocate: got %v, want %v", node.Idle, idleBefore)
+	}
+	if deallocateCalls != 0 {
+		t.Fatalf("deallocate-only handler called %d times without matching allocate", deallocateCalls)
+	}
+	task := tasks[0]
+	if task.Status != api.Pending || task.NodeName != "" || task.Pod.Spec.NodeName != "" {
+		t.Fatalf("failed Allocate did not restore task: status=%v node=%q podNode=%q",
+			task.Status, task.NodeName, task.Pod.Spec.NodeName)
+	}
