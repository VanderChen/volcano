+// TopologyNodeScopeForJob adapts the current hard HyperNode callbacks to an
+// exact physical Node scope. It unions the leaves of every eligible HyperNode;
+// callers compose this scope with the SubJob scope by physical Node
+// intersection.
+func (ssn *Session) TopologyNodeScopeForJob(
+	job *api.JobInfo,
+	root *api.HyperNodeInfo,
+) (*api.TopologyNodeScope, *api.HyperNodeGradientStats) {
+	gradients, stats := ssn.HyperNodeGradientForJobFn(job, root)
+	return ssn.topologyNodeScopeFromGradients(gradients), stats
+}
+
+// TopologyNodeScopeForSubJob adapts the current hard HyperNode callbacks to an
+// exact physical Node scope.
+func (ssn *Session) TopologyNodeScopeForSubJob(
+	subJob *api.SubJobInfo,
+	root *api.HyperNodeInfo,
+) (*api.TopologyNodeScope, *api.HyperNodeGradientStats) {
+	gradients, stats := ssn.HyperNodeGradientForSubJobFn(subJob, root)
+	return ssn.topologyNodeScopeFromGradients(gradients), stats
+}
+
+// ExactTopologyNodeScope composes all applicable Job and SubJob hard
+// constraints by physical Node intersection.
+func (ssn *Session) ExactTopologyNodeScope(
+	job *api.JobInfo,
+	subJob *api.SubJobInfo,
+) (*api.TopologyNodeScope, *api.HyperNodeGradientStats, *api.HyperNodeGradientStats) {
+	root := ssn.HyperNodes[ClusterTopHyperNode]
+	jobScope, jobStats := ssn.TopologyNodeScopeForJob(job, root)
+	subJobScope, subJobStats := ssn.TopologyNodeScopeForSubJob(subJob, root)
+	return jobScope.Intersect(subJobScope), jobStats, subJobStats
+}
+
+func (ssn *Session) topologyNodeScopeFromGradients(
+	gradients [][]*api.HyperNodeInfo,
+) *api.TopologyNodeScope {
+	scope := api.NewTopologyNodeScope()
+	for _, layer := range gradients {
+		for _, hyperNode := range layer {
+			if hyperNode == nil {
+				continue
+			}
+			if nodes, found := ssn.RealNodesSet[hyperNode.Name]; found {
+				scope.Nodes = scope.Nodes.Union(nodes)
+			}
+		}
+	}
+	return scope
+}
+
+// TopologyNodeScoreMap adapts the current SubJob/HyperNode soft scoring
+// callbacks to physical Nodes. Nodes are grouped by their lowest HyperNode, so
+// existing NTA SubJob aggregate scoring and GTA relation scoring keep their
+// current plugin-owned semantics while the allocator receives one score per
+// physical candidate.
+func (ssn *Session) TopologyNodeScoreMap(
+	subJob *api.SubJobInfo,
+	nodes []*api.NodeInfo,
+) (map[string]float64, error) {
+	if len(nodes) == 0 {
+		return map[string]float64{}, nil
+	}
+
+	nodeGroups := make(map[string][]*api.NodeInfo)
+	nodeToGroup := make(map[string]string, len(nodes))
+	for _, node := range nodes {
+		if node == nil {
+			continue
+		}
+		group := util.FindHyperNodeForNode(
+			node.Name, ssn.RealNodesList, ssn.HyperNodesTiers, ssn.HyperNodesSetByTier,
+		)
+		if group == "" {
+			group = ClusterTopHyperNode
+		}
+		nodeGroups[group] = append(nodeGroups[group], node)
+		nodeToGroup[node.Name] = group
+	}
+
+	pluginScores, err := ssn.HyperNodeOrderMapFn(subJob, nodeGroups)
+	if err != nil {
+		return nil, err
+	}
+	groupScores := make(map[string]float64, len(nodeGroups))
+	for _, scores := range pluginScores {
+		for group, score := range scores {
+			groupScores[group] += score
+		}
+	}
+
+	nodeScores := make(map[string]float64, len(nodeToGroup))
+	for nodeName, group := range nodeToGroup {
+		nodeScores[nodeName] = groupScores[group]
+	}
+	return nodeScores, nil
+}
