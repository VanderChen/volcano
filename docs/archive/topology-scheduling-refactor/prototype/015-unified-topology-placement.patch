+func TestUnifiedTopologyOrderedPlacementBacktracksFitFirst(t *testing.T) {
+	test, ssn, action := runOrderedPlacementTest(t, -1)
+	defer test.Close()
+
+	if err := test.CheckAll(0); err != nil {
+		job := ssn.Jobs[api.JobID("default/target")]
+		result := action.lastTopologyPlacementResult[job.UID]
+		t.Fatalf("%v; result=%s disposition=%s attempts=%d extra=%d backtracks=%d err=%v fit=%s tasks=%v",
+			err, result.kind, result.disposition, result.attempts, result.extra, result.backtracks,
+			result.err, job.FitError(), job.Tasks)
+	}
+	job := ssn.Jobs[api.JobID("default/target")]
+	if got := job.Tasks[api.TaskID("default-task-a")].NodeName; got != "node-2" {
+		t.Fatalf("task-a node = %q, want node-2 after rollback", got)
+	}
+	if got := job.Tasks[api.TaskID("default-task-b")].NodeName; got != "node-1" {
+		t.Fatalf("task-b node = %q, want node-1", got)
+	}
+	result := action.lastTopologyPlacementResult[job.UID]
+	if result.kind != topologyPlacementFound || result.disposition != topologyPlacementReady {
+		t.Fatalf("result = %s(%s), want Found(Ready)", result.kind, result.disposition)
+	}
+	if result.backtracks == 0 || result.extra == 0 {
+		t.Fatalf("backtracks=%d extra=%d, want bounded alternative to be used", result.backtracks, result.extra)
+	}
+}
