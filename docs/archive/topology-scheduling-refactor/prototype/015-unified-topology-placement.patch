+func TestExtenderTransactionalVerbCompatibility(t *testing.T) {
+	for _, testCase := range []struct {
+		name                string
+		deallocateVerb      string
+		wantDeallocateCalls int
+	}{
+		{
+			name:                "paired verbs rollback external callback",
+			deallocateVerb:      "deallocate",
+			wantDeallocateCalls: 1,
+		},
+		{
+			name:                "allocate-only remains loadable",
+			wantDeallocateCalls: 0,
+		},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			var lock sync.Mutex
+			calls := map[string]int{}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+				lock.Lock()
+				calls[request.URL.Path]++
+				lock.Unlock()
+				w.Header().Set("Content-Type", "application/json")
+				if err := json.NewEncoder(w).Encode(&EventHandlerResponse{}); err != nil {
+					t.Errorf("write fake extender response: %v", err)
+				}
+			}))
+			defer server.Close()
+
+			plugin := &extenderPlugin{
+				client: http.Client{},
+				config: &extenderConfig{
+					urlPrefix:          server.URL,
+					allocateFuncVerb:   "allocate",
+					deallocateFuncVerb: testCase.deallocateVerb,
+					managedResources:   sets.New[string](),
+				},
+			}
+			ssn, task, node := newExtenderStatementTestSession()
+			plugin.OnSessionOpen(ssn)
