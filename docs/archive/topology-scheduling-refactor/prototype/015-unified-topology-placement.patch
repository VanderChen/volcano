+		}
+		hyperNodeCopy := *hyperNode
+		if hyperNode.HyperNode != nil {
+			hyperNodeCopy.HyperNode = hyperNode.HyperNode.DeepCopy()
+		}
+		hyperNodeCopy.Children = hyperNode.Children.Clone()
+		cloned.HyperNodesMap[name] = &hyperNodeCopy
+	}
+	cloned.HyperNodesTierNameMap = make(api.HyperNodeTierNameMap, len(source.HyperNodesTierNameMap))
