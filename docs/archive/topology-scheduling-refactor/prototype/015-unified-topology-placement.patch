+func (p *orderedPlacementTestPluginImpl) OnSessionOpen(ssn *framework.Session) {
+	ssn.AddTaskOrderFn(orderedPlacementTestPlugin, func(left, right interface{}) int {
+		leftTask := left.(*api.TaskInfo)
+		rightTask := right.(*api.TaskInfo)
+		switch {
+		case leftTask.Name < rightTask.Name:
+			return -1
+		case leftTask.Name > rightTask.Name:
+			return 1
+		default:
+			return 0
+		}
+	})
+	ssn.AddPredicateFn(orderedPlacementTestPlugin, func(task *api.TaskInfo, node *api.NodeInfo) error {
+		if task.Name == "task-b" && node.Name != "node-1" {
+			return fmt.Errorf("task-b requires node-1")
+		}
+		return nil
+	})
+	ssn.AddNodeOrderFn(orderedPlacementTestPlugin, func(task *api.TaskInfo, node *api.NodeInfo) (float64, error) {
+		if task.Name == "task-a" && node.Name == "node-1" {
+			return 100, nil
+		}
+		return 0, nil
+	})
+	ssn.AddHyperNodeOrderFn(orderedPlacementTestPlugin, func(
+		_ *api.SubJobInfo,
+		hyperNodes map[string][]*api.NodeInfo,
+	) (map[string]float64, error) {
+		if p.topologyScoreError {
+			return nil, fmt.Errorf("injected topology score error")
+		}
+		scores := make(map[string]float64, len(hyperNodes))
+		return scores, nil
+	})
