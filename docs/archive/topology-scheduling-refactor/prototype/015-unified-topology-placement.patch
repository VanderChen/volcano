+func TestTaskBoundUnboundRestoresBucketAndManager(t *testing.T) {
+	task := &api.TaskInfo{
+		UID:      "task-1",
+		Job:      "job-1",
+		Name:     "worker-0",
+		TaskRole: "worker",
+		Resreq: &api.Resource{
+			MilliCPU: 1000,
+			Memory:   1024 * 1024,
+		},
+		Pod: &corev1.Pod{},
+	}
+	task.Pod.UID = types.UID(task.UID)
+
+	manager := NewJobManager(task.Job)
+	manager.podInTask[task.Pod.UID] = task.TaskRole
+	bucket := manager.NewBucket()
+	manager.AddTaskToBucket(bucket.index, task.TaskRole, task)
+
+	initialReqScore := bucket.reqScore
+	initialRequest := bucket.request.Clone()
+
+	task.NodeName = "node-1"
+	manager.TaskBound(task)
+	if bucket.boundTask != 1 || bucket.node["node-1"] != 1 {
+		t.Fatalf("bound state = boundTask:%d nodes:%v, want one task on node-1", bucket.boundTask, bucket.node)
+	}
+	if _, found := bucket.tasks[task.Pod.UID]; found {
+		t.Fatalf("bound task remained in pending bucket")
+	}
+
+	manager.TaskUnbound(task)
+	if bucket.boundTask != 0 || len(bucket.node) != 0 || len(bucket.boundTasks) != 0 {
+		t.Fatalf("unbound state = boundTask:%d nodes:%v boundTasks:%v, want empty",
+			bucket.boundTask, bucket.node, bucket.boundTasks)
+	}
+	if _, found := bucket.tasks[task.Pod.UID]; !found {
+		t.Fatalf("unbound task was not restored to pending bucket")
+	}
+	if bucket.reqScore != initialReqScore {
+		t.Fatalf("reqScore = %v, want %v", bucket.reqScore, initialReqScore)
+	}
+	if !bucket.request.Equal(initialRequest, api.Zero) {
+		t.Fatalf("request = %s, want %s", bucket.request, initialRequest)
+	}
+	if len(manager.nodeTaskSet) != 0 {
+		t.Fatalf("nodeTaskSet = %v, want empty", manager.nodeTaskSet)
+	}
+
+	// Duplicate callbacks must be harmless and remain exactly paired.
+	manager.TaskBound(task)
+	manager.TaskBound(task)
+	manager.TaskUnbound(task)
+	manager.TaskUnbound(task)
+	if bucket.boundTask != 0 || bucket.reqScore != initialReqScore {
+		t.Fatalf("duplicate callbacks changed bucket: boundTask=%d reqScore=%v", bucket.boundTask, bucket.reqScore)
+	}
+	if len(manager.nodeTaskSet) != 0 {
+		t.Fatalf("duplicate callbacks changed nodeTaskSet: %v", manager.nodeTaskSet)
+	}
+}
