+func TestStatementMarkRollback(t *testing.T) {
+	ssn, tasks, node := newStatementTestSession(t, 2)
+	eventBalance := 0
+	ssn.eventHandlers = []*EventHandler{{
+		AllocateFunc: func(_ *Event) {
+			eventBalance++
+		},
+		DeallocateFunc: func(_ *Event) {
+			eventBalance--
+		},
+	}}
+
+	stmt := NewStatement(ssn)
+	root := stmt.Mark()
+	if err := stmt.Allocate(tasks[0], node); err != nil {
+		t.Fatalf("allocate first task: %v", err)
+	}
+	afterFirst := stmt.Mark()
+	if err := stmt.Allocate(tasks[1], node); err != nil {
+		t.Fatalf("allocate second task: %v", err)
+	}
+
+	if err := stmt.RollbackTo(afterFirst); err != nil {
+		t.Fatalf("rollback to inner mark: %v", err)
+	}
+	if got := len(stmt.Operations()); got != 1 {
+		t.Fatalf("operation count after inner rollback = %d, want 1", got)
+	}
+	if tasks[0].Status != api.Allocated || tasks[1].Status != api.Pending {
+		t.Fatalf("task statuses after inner rollback = %v/%v, want Allocated/Pending",
+			tasks[0].Status, tasks[1].Status)
+	}
+	if eventBalance != 1 {
+		t.Fatalf("event balance after inner rollback = %d, want 1", eventBalance)
+	}
+
+	if err := stmt.RollbackTo(root); err != nil {
+		t.Fatalf("rollback to root: %v", err)
+	}
+	if got := len(stmt.Operations()); got != 0 {
+		t.Fatalf("operation count after root rollback = %d, want 0", got)
+	}
+	for _, task := range tasks {
+		if task.Status != api.Pending || task.NodeName != "" || task.Pod.Spec.NodeName != "" {
+			t.Fatalf("task %s was not restored: status=%v node=%q podNode=%q",
+				task.Name, task.Status, task.NodeName, task.Pod.Spec.NodeName)
+		}
+	}
+	if len(node.Tasks) != 0 {
+		t.Fatalf("node retained tasks after root rollback: %v", node.Tasks)
+	}
+	if eventBalance != 0 {
+		t.Fatalf("event balance after root rollback = %d, want 0", eventBalance)
+	}
+}
