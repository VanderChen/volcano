+// operations silently applied.
+func (s *Statement) RollbackTo(mark StatementMark) error {
+	if mark < 0 || int(mark) > len(s.operations) {
+		return fmt.Errorf("invalid statement mark %d for %d operations", mark, len(s.operations))
+	}
+
+	errInfos := make([]error, 0)
+	for i := len(s.operations) - 1; i >= int(mark); i-- {
+		if err := s.rollbackOperation(s.operations[i]); err != nil {
+			errInfos = append(errInfos, fmt.Errorf("rollback operation %d: %w", i, err))
+		}
+	}
+	s.operations = s.operations[:int(mark)]
+	return errors.Join(errInfos...)
