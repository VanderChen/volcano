+			}
+			if err := statement.RollbackTo(0); err != nil {
+				t.Fatalf("rollback with extender callback: %v", err)
+			}
+
+			lock.Lock()
+			allocateCalls := calls["/allocate"]
+			deallocateCalls := calls["/deallocate"]
+			lock.Unlock()
+			if allocateCalls != 1 || deallocateCalls != testCase.wantDeallocateCalls {
+				t.Fatalf("extender calls allocate=%d deallocate=%d, want 1/%d",
+					allocateCalls, deallocateCalls, testCase.wantDeallocateCalls)
+			}
+			if task.Status != api.Pending || task.NodeName != "" || len(node.Tasks) != 0 {
+				t.Fatalf("statement rollback leaked state: status=%v node=%q nodeTasks=%d",
+					task.Status, task.NodeName, len(node.Tasks))
+			}
