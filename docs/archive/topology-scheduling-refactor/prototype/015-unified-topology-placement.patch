+			flexible.NodeName == wantFlexibleNode &&
+			node.Name == "node-16" {
+			return nil
+		}
+		return fmt.Errorf("task-b is enabled only after task-a selects alternative %d", p.successAlternative)
+	})
+	ssn.AddNodeOrderFn(backtrackBenchmarkPlugin, func(task *api.TaskInfo, node *api.NodeInfo) (float64, error) {
+		if task.Name != "task-a" {
+			return 0, nil
+		}
+		index, err := strconv.Atoi(strings.TrimPrefix(node.Name, "node-"))
+		if err != nil {
+			return 0, err
+		}
+		return float64(1000 - index), nil
