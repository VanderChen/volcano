+func TestStatementPipelineFailureIsAtomic(t *testing.T) {
+	ssn, tasks, node := newStatementTestSession(t, 1)
+	eventBalance := 0
+	ssn.eventHandlers = []*EventHandler{{
+		AllocateFunc: func(event *Event) {
+			eventBalance++
+			event.Err = errors.New("injected pipeline callback error")
+		},
+		DeallocateFunc: func(_ *Event) {
+			eventBalance--
+		},
+	}}
+
+	stmt := NewStatement(ssn)
+	err := stmt.Pipeline(tasks[0], node.Name, false)
+	if err == nil {
+		t.Fatalf("Pipeline returned nil, want injected error")
