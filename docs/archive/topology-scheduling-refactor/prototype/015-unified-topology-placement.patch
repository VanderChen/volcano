+			eventBalance++
+			event.Err = errors.New("injected allocate callback error")
+		},
+		DeallocateFunc: func(_ *Event) {
+			eventBalance--
+		},
+	}}
+
+	stmt := NewStatement(ssn)
+	err := stmt.Allocate(tasks[0], node)
+	if err == nil {
+		t.Fatalf("Allocate returned nil, want injected error")
+	}
+	if got := len(stmt.Operations()); got != 0 {
+		t.Fatalf("failed Allocate recorded %d operations, want 0", got)
+	}
+	task := tasks[0]
+	if task.Status != api.Pending || task.NodeName != "" || task.Pod.Spec.NodeName != "" {
+		t.Fatalf("failed Allocate leaked task state: status=%v node=%q podNode=%q",
+			task.Status, task.NodeName, task.Pod.Spec.NodeName)
+	}
+	if len(node.Tasks) != 0 {
+		t.Fatalf("failed Allocate leaked node task: %v", node.Tasks)
+	}
