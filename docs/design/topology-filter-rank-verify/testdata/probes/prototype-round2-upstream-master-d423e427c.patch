+
+package framework
+
+// PROTOTYPE (issue 004): compose co-location constraints with exclusion
+// constraints. A co-location constraint lists containers: the unit must fit
+// inside one of them. An exclusion constraint only narrows the usable region.
+// A candidate is a container restricted to the region, so a container that is
+// partly excluded stays a candidate.
+
+import (
+	"os"
+
+	"k8s.io/apimachinery/pkg/util/sets"
+
+	"volcano.sh/volcano/pkg/scheduler/api"
+)
+
+// ProbeScopeUnion enables the composition. Off by default.
+var ProbeScopeUnion = os.Getenv("VC_PROBE_SCOPE_UNION") == "1"
+
+// resolveHyperNodeGradientsWithScope is called when at least one constrained
+// plugin result is marked as a scope.
+func (ssn *Session) resolveHyperNodeGradientsWithScope(
+	constrained []api.HyperNodePluginGradient,
+	root *api.HyperNodeInfo,
+	purpose api.SearchPurpose,
+) ([][]*api.HyperNodeInfo, *api.HyperNodeGradientStats) {
+	var containers, scopes []api.HyperNodePluginGradient
+	for _, result := range constrained {
+		if result.Scope {
+			scopes = append(scopes, result)
+		} else {
+			containers = append(containers, result)
+		}
+	}
+	stats := &api.HyperNodeGradientStats{PluginEligibleByTier: make(map[string]map[int]int, len(constrained))}
+	for _, result := range constrained {
+		stats.PluginEligibleByTier[result.PluginName] = hyperNodeCountByTier(result.Gradients)
+	}
+
+	// Containers: what the co-location constraints allow, or the whole subtree
+	// when no plugin states one.
+	var candidates [][]*api.HyperNodeInfo
+	if len(containers) > 0 {
+		candidates, _ = intersectHyperNodeGradients(containers, purpose)
+	} else {
+		candidates = ssn.expandHyperNodeSubtree(root, purpose)
+	}
+
+	// Region: HyperNodes that every exclusion constraint leaves fully usable.
+	allowed := api.HyperNodeNamesInGradients(scopes[0].Gradients)
+	for _, scope := range scopes[1:] {
+		allowed = allowed.Intersection(api.HyperNodeNamesInGradients(scope.Gradients))
+	}
+	// A container that is an ancestor of a usable HyperNode overlaps the region.
+	overlapping := sets.New[string]()
+	for name := range allowed {
+		for _, ancestor := range ssn.HyperNodes.GetAncestors(name) {
+			overlapping.Insert(ancestor)
+		}
+	}
+
+	result := make([][]*api.HyperNodeInfo, 0, len(candidates))
+	final := sets.New[string]()
+	for _, layer := range candidates {
+		kept := make([]*api.HyperNodeInfo, 0, len(layer))
+		for _, hn := range layer {
+			if hn != nil && overlapping.Has(hn.Name) {
+				kept = append(kept, hn)
+				final.Insert(hn.Name)
+			}
+		}
+		if len(kept) > 0 {
+			result = append(result, kept)
+		}
+	}
+	stats.IntersectedByTier = hyperNodeCountByTier(result)
+	stats.ExcludedByReason = api.ComputePluginExcludedHyperNodes(constrained, final)
+	stats.ScopeHyperNodes = allowed
+	return result, stats
+}
+
+// expandHyperNodeSubtree lists every HyperNode under root, low tier first.
+func (ssn *Session) expandHyperNodeSubtree(root *api.HyperNodeInfo, purpose api.SearchPurpose) [][]*api.HyperNodeInfo {
+	hyperNodeByName := make(map[string]*api.HyperNodeInfo)
+	eligible := sets.New[string]()
+	queue := []*api.HyperNodeInfo{root}
+	for len(queue) > 0 {
+		hn := queue[0]
+		queue = queue[1:]
+		if hn == nil || eligible.Has(hn.Name) {
+			continue
+		}
+		eligible.Insert(hn.Name)
+		hyperNodeByName[hn.Name] = hn
+		for child := range hn.Children {
+			if childHN := ssn.HyperNodes[child]; childHN != nil {
+				queue = append(queue, childHN)
+			}
+		}
+	}
+	return rebuildGradientsByTier(hyperNodeByName, eligible, purpose)
+}
