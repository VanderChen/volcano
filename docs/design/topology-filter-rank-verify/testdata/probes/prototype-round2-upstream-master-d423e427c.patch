+package allocate
+
+// PROTOTYPE (issue 004): usable region of a Job and failure-path repair.
+//
+// Region: when an exclusion constraint (required PodGroup anti-affinity)
+// narrows the nodes a Job may use, tasks are only offered nodes inside it,
+// whatever container is being tried.
+//
+// Repair: SubJobs are placed one after another. When the normal search ends
+// without a solution, containers in which a SubJob failed after another SubJob
+// had been placed are tried again with the blocked SubJobs first. Nothing is
+// repaired while the normal search succeeds, so a Job that is schedulable
+// without repair keeps exactly the placement it has today.
+
+import (
+	"fmt"
+	"strings"
+
+	"k8s.io/apimachinery/pkg/util/sets"
+
+	"volcano.sh/volcano/pkg/scheduler/api"
+	"volcano.sh/volcano/pkg/scheduler/framework"
+	"volcano.sh/volcano/pkg/scheduler/unschedulable"
+)
+
+// setScope derives the usable nodes of the Job from the gradient statistics.
+func (alloc *Action) setScope(job *api.JobInfo, stats *api.HyperNodeGradientStats) {
+	alloc.scopeNodes = nil
+	if stats == nil || stats.ScopeHyperNodes == nil {
+		return
+	}
+	ssn := alloc.session
+	alloc.scopeNodes = sets.New[string]()
+	for name := range stats.ScopeHyperNodes {
+		for node := range ssn.RealNodesSet[name] {
+			alloc.scopeNodes.Insert(node)
+		}
+	}
+	if alloc.trace != nil {
+		// report the top-most usable HyperNodes only
+		var roots []string
+		for name := range stats.ScopeHyperNodes {
+			inner := false
+			for _, ancestor := range ssn.HyperNodes.GetAncestors(name) {
+				if ancestor != name && stats.ScopeHyperNodes.Has(ancestor) {
+					inner = true
+					break
+				}
+			}
+			if !inner {
+				roots = append(roots, name)
+			}
+		}
+		alloc.trace.Scopes = append(alloc.trace.Scopes, ScopeRecord{Job: string(job.UID), Roots: sets.List(sets.New(roots...))})
+	}
+}
+
+// nodesInScope drops nodes outside the usable region of the current Job.
+func (alloc *Action) nodesInScope(nodes []*api.NodeInfo) []*api.NodeInfo {
+	if alloc.scopeNodes == nil {
+		return nodes
+	}
+	kept := make([]*api.NodeInfo, 0, len(nodes))
+	for _, node := range nodes {
+		if node != nil && alloc.scopeNodes.Has(node.Name) {
+			kept = append(kept, node)
+		}
+	}
+	return kept
+}
+
+// ScopeRecord explains which region a Job was allowed to use.
+type ScopeRecord struct {
+	Job   string
+	Roots []string
+}
+
+// RepairRecord explains one repair attempt.
+type RepairRecord struct {
+	Job       string
+	Container string
+	Attempt   int
+	// First lists the SubJobs moved to the front for this attempt.
+	First   []string
+	Blocked []string
+	Success bool
+}
+
+func (r RepairRecord) String() string {
+	outcome := "failed"
+	if r.Success {
+		outcome = "succeeded"
+	}
+	msg := fmt.Sprintf("job %s in %s: retry %d with [%s] first %s", r.Job, r.Container, r.Attempt, strings.Join(r.First, ", "), outcome)
+	if len(r.Blocked) > 0 {
+		msg += fmt.Sprintf("; still blocked: [%s]", strings.Join(r.Blocked, ", "))
+	}
+	return msg
+}
+
+// repairCandidate is a container in which the normal search placed some
+// SubJobs and then found others blocked.
+type repairCandidate struct {
+	layer     int
+	hyperNode *api.HyperNodeInfo
+	blocked   []api.SubJobID
+}
+
+func subJobNames(ids []api.SubJobID) []string {
+	names := make([]string, 0, len(ids))
+	for _, id := range ids {
+		names = append(names, string(id))
+	}
+	return names
+}
+
+// blockedFirst puts the SubJobs blocked in the last attempt first, followed
+// by the SubJobs that were first before.
+func blockedFirst(previous, blocked []api.SubJobID) []api.SubJobID {
+	seen := sets.New[api.SubJobID]()
+	order := make([]api.SubJobID, 0, len(previous)+len(blocked))
+	for _, id := range append(append([]api.SubJobID{}, blocked...), previous...) {
+		if !seen.Has(id) {
+			seen.Insert(id)
+			order = append(order, id)
+		}
+	}
+	return order
+}
+
+// placeSubJobsInOrder dry-runs the Job in one container. SubJobs listed in
+// first are handled before the others; the others keep their queue order.
+// blocked lists SubJobs that found no place after another SubJob was placed.
+func (alloc *Action) placeSubJobsInOrder(
+	job *api.JobInfo,
+	jobWorksheet *JobWorksheet,
+	hyperNode *api.HyperNodeInfo,
+	baseline string,
+	first []api.SubJobID,
+) (stmtList []*framework.Statement, worksheet *JobWorksheet, blocked []api.SubJobID) {
+	ssn := alloc.session
+	worksheet = jobWorksheet.Clone()
+	byID := map[api.SubJobID]*api.SubJobInfo{}
+	var queueOrder []*api.SubJobInfo
+	for !worksheet.subJobs.Empty() {
+		subJob := worksheet.subJobs.Pop().(*api.SubJobInfo)
+		byID[subJob.UID] = subJob
+		queueOrder = append(queueOrder, subJob)
+	}
+	var order []*api.SubJobInfo
+	moved := sets.New[api.SubJobID]()
+	for _, id := range first {
+		if subJob, found := byID[id]; found && !moved.Has(id) {
+			moved.Insert(id)
+			order = append(order, subJob)
+		}
+	}
+	for _, subJob := range queueOrder {
+		if !moved.Has(subJob.UID) {
+			order = append(order, subJob)
+		}
+	}
+
+	for len(order) > 0 {
+		subJob := order[0]
+		order = order[1:]
+		subJobWorksheet := worksheet.subJobWorksheets[subJob.UID]
+		stmt, _ := alloc.allocateForSubJob(subJob, subJobWorksheet, hyperNode, baseline)
+		if stmt == nil || len(stmt.Operations()) == 0 {
+			if len(stmtList) > 0 {
+				blocked = append(blocked, subJob.UID)
+				continue
+			}
+			// Nothing has been placed yet, so this container cannot host the
+			// SubJob at all. A Job that needs every task cannot fit here.
+			if int(job.MinAvailable) >= len(job.Tasks) {
+				order = append(order, subJob)
+				break
+			}
+			continue
+		}
+		stmtList = append(stmtList, stmt)
+		if !subJobWorksheet.Empty() {
+			order = append(order, subJob)
+		}
+		if ssn.JobReady(job) {
+			break
+		}
+	}
+	// SubJobs that were not reached stay in the worksheet, as in the normal loop.
+	for _, subJob := range order {
+		worksheet.subJobs.Push(subJob)
+	}
+	alloc.recorder.RecoverSubJobStatus(job)
+	return stmtList, worksheet, blocked
+}
+
+// repairJob runs after the normal search found no solution.
+func (alloc *Action) repairJob(
+	job *api.JobInfo,
+	jobWorksheet *JobWorksheet,
+	candidates []repairCandidate,
+	baseline string,
+	failedCandidateRejections *[]unschedulable.Rejection,
+	used *int,
+	reserveForLast bool,
+) *framework.Statement {
+	if alloc.repairBudget <= 0 {
+		return nil
+	}
+	ssn := alloc.session
+	var eligible []repairCandidate
+	for _, candidate := range candidates {
+		if alloc.containerMayHostJob(job, jobWorksheet, candidate.hyperNode) {
+			eligible = append(eligible, candidate)
+		}
+	}
+	attempts := *used
+	defer func() { *used = attempts }()
+	for i, candidate := range eligible {
+		limit := alloc.repairBudget
+		if reserveForLast && i < len(eligible)-1 {
+			limit-- // keep one attempt for the widest container
+		}
+		first := candidate.blocked
+		tried := sets.New[string](strings.Join(subJobNames(first), ","))
+		for attempts < limit {
+			attempts++
+			var stmtList []*framework.Statement
+			var worksheet *JobWorksheet
+			var blocked []api.SubJobID
+			rejections := ssn.CollectJobRejections(job.UID, func() {
+				job.JobFitErrors = baseline
+				job.ResetFitErr()
+				stmtList, worksheet, blocked = alloc.placeSubJobsInOrder(job, jobWorksheet, candidate.hyperNode, baseline, first)
+			})
+			operations := 0
+			for _, stmt := range stmtList {
+				operations += len(stmt.Operations())
+			}
+			success := operations > 0 && (ssn.JobReady(job) || ssn.JobPipelined(job))
+			if alloc.trace != nil {
+				alloc.trace.Repairs = append(alloc.trace.Repairs, RepairRecord{
+					Job: string(job.UID), Container: candidate.hyperNode.Name, Attempt: attempts,
+					First: subJobNames(first), Blocked: subJobNames(blocked), Success: success,
+				})
+			}
+			if success {
+				finalStmt := framework.NewStatement(ssn)
+				finalStmt.Merge(stmtList...)
+				jobWorksheet.ShallowCopyFrom(worksheet)
+				alloc.recorder.SaveJobDecision(job.UID, candidate.hyperNode.Name)
+				return finalStmt
+			}
+			*failedCandidateRejections = append(*failedCandidateRejections, rejections...)
+			for _, stmt := range stmtList {
+				stmt.Discard()
+			}
+			if len(blocked) == 0 {
+				break
+			}
+			first = blockedFirst(first, blocked)
+			key := strings.Join(subJobNames(first), ",")
+			if tried.Has(key) {
+				break
+			}
+			tried.Insert(key)
+		}
+		if attempts >= alloc.repairBudget {
+			break
+		}
+	}
+	if alloc.trace != nil && attempts >= alloc.repairBudget && len(eligible) > 0 {
+		alloc.trace.RepairBudgetExhausted = append(alloc.trace.RepairBudgetExhausted, string(job.UID))
+	}
+	return nil
+}
+
+// containerMayHostJob is a necessary condition that keeps the repair budget
+// for containers worth retrying: for a strict gang, the usable nodes of the
+// container must offer at least the summed requests of the pending tasks.
+// Fragmentation is ignored, so true proves nothing.
+func (alloc *Action) containerMayHostJob(job *api.JobInfo, jobWorksheet *JobWorksheet, hyperNode *api.HyperNodeInfo) bool {
+	if int(job.MinAvailable) < len(job.Tasks) {
+		return true
+	}
+	need := api.EmptyResource()
+	for _, worksheet := range jobWorksheet.subJobWorksheets {
+		pending := worksheet.tasks.Clone()
+		for !pending.Empty() {
+			need.Add(pending.Pop().(*api.TaskInfo).InitResreq)
+		}
+	}
+	have := api.EmptyResource()
+	for _, node := range alloc.nodesInScope(alloc.session.RealNodesList[hyperNode.Name]) {
+		have.Add(node.FutureIdle())
+	}
+	return need.LessEqual(have, api.Zero)
+}
