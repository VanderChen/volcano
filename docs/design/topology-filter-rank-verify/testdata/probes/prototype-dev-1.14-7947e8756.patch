+// Merge moves the operations of live statements of the same session into s.
+// PROTOTYPE (issue 004): backport of the upstream helper.
+func (s *Statement) Merge(stmts ...*Statement) {
+	for _, stmt := range stmts {
+		s.operations = append(s.operations, stmt.operations...)
+		stmt.operations = nil
+	}
+}
+
 func SaveOperations(stmts ...*Statement) *Statement {
 	stmtTmp := &Statement{}
 	for _, stmt := range stmts {
