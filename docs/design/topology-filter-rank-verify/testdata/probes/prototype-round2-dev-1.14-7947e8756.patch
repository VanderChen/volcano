+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package framework
+
+// PROTOTYPE (issue 004): compose co-location constraints with exclusion
+// constraints. A co-location constraint lists containers: the unit must fit
+// inside one of them. An exclusion constraint only narrows the usable region.
+// A candidate is a container restricted to the region, so a container that is
+// partly excluded stays a candidate.
+
+import (
+	"os"
+
+	"k8s.io/apimachinery/pkg/util/sets"
+
+	"volcano.sh/volcano/pkg/scheduler/api"
+)
+
+// ProbeScopeUnion enables the composition. Off by default.
+var ProbeScopeUnion = os.Getenv("VC_PROBE_SCOPE_UNION") == "1"
+
+// ProbeScopeFallback keeps today's search as the normal path for Jobs that
+// use the PodGroup anti-affinity candidate forest and applies the usable
+// region only after that search found no solution.
+var ProbeScopeFallback = os.Getenv("VC_PROBE_SCOPE_FALLBACK") == "1"
+
+func (ssn *Session) intersectHyperNodeGradientsWithScope(
+	gradientByPlugin []api.HyperNodePluginGradient,
+	universe [][]*api.HyperNodeInfo,
+) ([][]*api.HyperNodeInfo, *api.HyperNodeGradientStats) {
+	var containers, scopes []api.HyperNodePluginGradient
+	for _, result := range gradientByPlugin {
+		if result.Applied && result.Scope {
+			scopes = append(scopes, result)
+		} else {
+			containers = append(containers, result)
+		}
+	}
+	if len(scopes) == 0 {
+		return intersectHyperNodeGradients(gradientByPlugin, universe)
+	}
+
+	// Containers: what the co-location constraints allow, or the whole
+	// candidate universe when no plugin states one.
+	candidates, stats := intersectHyperNodeGradients(containers, universe)
+
+	// Region: HyperNodes that every exclusion constraint leaves fully usable.
+	allowed := api.HyperNodeNamesInGradients(scopes[0].Gradients)
+	for _, scope := range scopes[1:] {
+		allowed = allowed.Intersection(api.HyperNodeNamesInGradients(scope.Gradients))
+	}
+	// A container that is an ancestor of a usable HyperNode overlaps the region.
+	overlapping := sets.New[string]()
+	for name := range allowed {
+		overlapping.Insert(name)
+		for _, ancestor := range ssn.HyperNodes.GetAncestors(name) {
+			overlapping.Insert(ancestor)
+		}
+	}
+
+	result := make([][]*api.HyperNodeInfo, 0, len(candidates))
+	for _, layer := range candidates {
+		kept := make([]*api.HyperNodeInfo, 0, len(layer))
+		for _, hn := range layer {
+			if hn != nil && overlapping.Has(hn.Name) {
+				kept = append(kept, hn)
+			}
+		}
+		if len(kept) > 0 {
+			result = append(result, kept)
+		}
+	}
+	for _, scope := range scopes {
+		stats.PluginEligibleByTier[scope.PluginName] = hyperNodeCountByTier(scope.Gradients)
+	}
+	stats.IntersectedByTier = hyperNodeCountByTier(result)
+	stats.ScopeHyperNodes = allowed
+	return result, stats
+}
