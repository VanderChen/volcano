diff --git a/pkg/scheduler/framework/probe_scope.go b/pkg/scheduler/framework/probe_scope.go
new file mode 100644
index 000000000..668efcb51
--- /dev/null
+++ b/pkg/scheduler/framework/probe_scope.go
@@ -0,0 +1,93 @@
+/*
